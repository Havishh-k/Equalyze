# Equalyze — Environment Configuration
# =====================================

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# GCP
GOOGLE_CLOUD_PROJECT=equalyze-dev
GOOGLE_APPLICATION_CREDENTIALS=./api/firebase-adminsdk.json

# BigQuery
BQ_DATASET_ID=equalyze_audit_logs
BQ_LOCATION=us-central1

# Auth (JWT for demo accounts)
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256

# Backend
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# API (used by frontend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Storage (local for dev, GCS for prod)
STORAGE_MODE=local
LOCAL_STORAGE_PATH=./storage

# Environment
ENVIRONMENT=development
